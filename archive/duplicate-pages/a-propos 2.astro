---
import BaseLayout from '../layouts/BaseLayout.astro';
import Visual from '../components/Visual.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import ContactCTA from '../components/ContactCTA.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { introduction, tools } from '../data/profile';
---
<BaseLayout title="À propos — Emma Expert"><section class="page-heading shell"><span class="eyebrow">EMMA EXPERT · NICE, FRANCE</span><h1>Imaginer.<br/><em>Donner forme.</em></h1></section><section class="about-preview shell about-full"><div class="portrait"><Visual file="p3-20.png" alt="Portrait d’Emma Expert" eager/></div><div class="about-preview-text"><h2>Designer d’espace,<br/><em>par sensibilité.</em></h2><p>{introduction}</p><p>J’ai depuis longtemps un intérêt pour la capacité à donner à chaque espace une fonction juste et à améliorer l’expérience de chacun.</p><p>Curieuse et motivée, je recherche une alternance : <strong>4 jours en entreprise, 1 jour à l’école</strong>, pour approfondir mes compétences et contribuer activement à des projets concrets.</p><a href="/portfolio-emma-expert-2026.pdf" download class="text-link">Mon portfolio & CV ↓</a></div></section><section class="shell experience" id="parcours"><SectionHeading number="01" title="Le parcours" note="EXPÉRIENCES"/><ExperienceTimeline full/></section><section class="shell qualifications"><SectionHeading number="02" title="Apprendre & pratiquer" note="FORMATION ET OUTILS"/><div class="qualifications-grid"><div><span class="eyebrow">FORMATION</span><article><span>2022 — 2025</span><h3>École de Condé Nice</h3><p>Bachelor en architecture intérieure et scénographie de luxe.<br/>Diplômée et admise en mastère.</p></article><article><span>2021 — 2022</span><h3>Lycée Honoré d’Estienne d’Orves</h3><p>Baccalauréat · Arts plastiques, mathématiques et SES.<br/>Nice, France.</p></article></div><div><span class="eyebrow">OUTILS & PRATIQUES</span><ul class="tools-list">{tools.map(t=><li>{t}</li>)}</ul><div class="languages"><span class="eyebrow">LANGUES</span><p>Français · langue maternelle<br/>Anglais · B2</p></div></div></div><div class="interests"><span class="eyebrow">EN DEHORS DU STUDIO</span><p>Théâtre · Cinéma · Architecture · Scénographie · Bateau à voile · Danse</p></div></section><ContactCTA/></BaseLayout>
