---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Visual from '../components/Visual.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import ContactCTA from '../components/ContactCTA.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import { introduction } from '../data/profile';
const projects = (await getCollection('projects')).sort((a,b) => a.data.number.localeCompare(b.data.number));
---
<BaseLayout><section class="hero shell" aria-labelledby="hero-title"><div class="hero-topline eyebrow"><span>PORTFOLIO — 2026</span><span>UNE APPROCHE SENSIBLE DE L’ESPACE</span></div><div class="hero-composition"><div class="hero-text"><span class="eyebrow hero-index">DESIGN D’ESPACE<br/>ARCHITECTURE INTÉRIEURE<br/>SCÉNOGRAPHIE</span><h1 id="hero-title">Habiter<br/>l’espace.<br/><em>Éveiller</em><br/><em>les sens.</em></h1><div class="hero-signature"><span>Emma Expert</span><span class="eyebrow">NICE, FRANCE</span></div></div><a href="/projets/habitat-de-a-a-z/" class="hero-visual"><Visual file="p6-0.png" alt="Habitat de A à Z : intérieur lumineux, bois chaleureux et pouf vert minéral" eager transitionName="project-habitat-de-a-a-z" sizes="(max-width: 700px) 90vw, 50vw"/><span class="hero-vertical">HABITAT DE A À Z — ARCHITECTURE INTÉRIEURE</span><span class="hero-image-caption"><span>01 — HABITAT DE A À Z</span><span>VOIR LE PROJET ↗</span></span></a></div><div class="hero-bottom"><a href="#selection">EXPLORER LE PORTFOLIO <span>↓</span></a><span class="eyebrow">DE L’INTENTION À LA MATIÈRE.</span></div></section>
<section class="introduction shell"><span class="eyebrow">LE REGARD</span><div><h2>Donner à chaque espace<br/><em>une fonction juste.</em></h2><p>J’ai grandi entre imagination et création. Concevoir des lieux qui améliorent l’expérience de chacun est ce qui me passionne.</p><a class="text-link" href="/a-propos/">Découvrir mon parcours ↗</a></div><span class="intro-marker" aria-hidden="true">e.</span></section>
<section id="selection" class="selected shell"><SectionHeading number="01" title="Espaces à vivre" note="PROJETS ACADÉMIQUES · 3 PROJETS"/><div class="selected-projects">{projects.filter(p=>p.data.featured).map(p=><ProjectPreview project={p}/>)}</div><a class="text-link all-projects" href="/projets/">Le portfolio complet <span>↗</span></a></section>
<section class="scenography shell"><SectionHeading number="02" title="Habiter autrement" note="SCÉNOGRAPHIE"/><div class="section-intro"><p>Entre réalité et imaginaire,<br/>l’espace devient un récit.</p><span class="eyebrow">EXPLORATIONS SPATIALES<br/>ET SENSIBLES</span></div><div class="two-projects">{projects.filter(p=>['habiter-la-scene','les-arches-vielha'].includes(p.id)).map(p=><ProjectPreview project={p} compact/>)}</div></section>
<section class="drawings shell"><SectionHeading number="03" title="Le langage du trait" note="DESSINS & RECHERCHES"/><div class="drawing-composition"><a href="/projets/dessins/" class="drawing-first"><Visual file="p31-0.png" alt="Dessin d’une basilique au crayon"/><span class="eyebrow">ARCHITECTURE · CRAYON</span></a><div class="drawing-text"><h3>Observer,<br/><em>avant de concevoir.</em></h3><p>Architecture, objets, corps : le dessin permet de comprendre les volumes et de donner forme aux idées.</p><a href="/projets/dessins/" class="text-link">Ouvrir le carnet ↗</a></div><a href="/projets/dessins/" class="drawing-last"><Visual file="p33-1.png" alt="Étude de la chaise Wassily de Marcel Breuer au feutre noir"/><span class="eyebrow">OBJETS · FEUTRE FIN</span></a></div></section>
<section class="about-preview shell"><div class="portrait"><Visual file="p3-20.png" alt="Portrait en noir et blanc d’Emma Expert"/><span class="eyebrow">EMMA EXPERT · DESIGNER D’ESPACE</span></div><div class="about-preview-text"><span class="eyebrow">À PROPOS</span><h2>Entre imagination<br/><em>et création.</em></h2><p>{introduction}</p><p>Je recherche une alternance pour approfondir mes compétences et contribuer activement à des projets concrets.</p><a href="/a-propos/" class="text-link">À propos d’Emma ↗</a></div></section>
<section class="experience shell"><SectionHeading number="04" title="Au contact du réel" note="EXPÉRIENCES"/><ExperienceTimeline/><div class="experience-links"><a href="/projets/#en-stage" class="text-link">Les travaux en stage ↗</a><a href="/a-propos/#parcours" class="text-link">Tout le parcours ↗</a></div></section><ContactCTA/></BaseLayout>
