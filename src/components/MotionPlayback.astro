---
import { translator } from '../i18n';
const t = translator(Astro.url);
---
<button class="motion-playback" data-motion-toggle hidden data-pause-label={t('Mettre les animations en pause')} data-play-label={t('Lire les animations')} aria-pressed="false">{t('Mettre les animations en pause')}</button>
<style>
  .motion-playback { position: relative; z-index: 3; flex-shrink: 0; border: 1px solid var(--color-border); background: var(--color-bg); color: var(--color-text); font: inherit; font-size: 11px; padding: 12px 16px; min-height: 44px; cursor: pointer; }
  :global(.playback-host) { position: relative; }
  :global(.playback-host .motion-playback) { position: absolute; bottom: 18px; right: 18px; }
  @media (max-width: 700px) {
    :global(.hero-bottom) { flex-wrap: wrap; gap: 8px; }
    :global(.hero-bottom .motion-playback) { margin-inline: auto; }
  }
  .motion-playback[hidden] { display: none; }
  .motion-playback:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
</style>
<script>
import '../scripts/video-motion';
</script>
