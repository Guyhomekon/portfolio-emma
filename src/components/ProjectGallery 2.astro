---
import Visual from './Visual.astro';
const { gallery, title } = Astro.props;
---
<div class="project-gallery">{gallery.map((item: { title: string; image: string; page: number }, index: number) => <section class="gallery-section"><div class="gallery-heading"><span class="eyebrow">{String(index+1).padStart(2,'0')} / PROCESSUS</span><h2>{item.title}</h2><span class="eyebrow">PORTFOLIO · P. {item.page}</span></div><figure><button class="gallery-zoom" data-gallery-open aria-label={`Agrandir : ${item.title}`}><Visual file={item.image} alt={`${title} — ${item.title}, planche originale du portfolio`} sizes="(max-width: 700px) 100vw, 90vw"/><span class="zoom-label">AGRANDIR ↗</span></button><figcaption>{title} · {item.title}</figcaption></figure></section>)}</div>
<dialog class="lightbox" aria-label="Vue agrandie du portfolio"><div class="lightbox-toolbar"><p class="lightbox-caption"></p><button class="lightbox-close" aria-label="Fermer la vue agrandie">Fermer ×</button></div><img class="lightbox-image" alt=""/></dialog>
<script>
function setupGallery() { const dialog = document.querySelector<HTMLDialogElement>('.lightbox'); if (!dialog) return; const image = dialog.querySelector<HTMLImageElement>('.lightbox-image')!; let opener: HTMLElement | null = null; document.querySelectorAll<HTMLButtonElement>('[data-gallery-open]').forEach(button => button.addEventListener('click', () => { const original = button.querySelector('img')!; opener = button; image.src = original.currentSrc || original.src; image.alt = original.alt; dialog.querySelector('.lightbox-caption')!.textContent = original.alt; dialog.showModal(); document.body.classList.add('modal-open'); })); dialog.querySelector('.lightbox-close')!.addEventListener('click', () => dialog.close()); dialog.addEventListener('click', e => { if (e.target === dialog) dialog.close(); }); dialog.addEventListener('close', () => { document.body.classList.remove('modal-open'); opener?.focus(); }); }
document.addEventListener('astro:page-load',setupGallery);
</script>
