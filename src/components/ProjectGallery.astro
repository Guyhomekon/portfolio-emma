---
import { translator } from '../i18n';
const t = translator(Astro.url);
import Visual from './Visual.astro';
import ArchitecturalGuides from './ArchitecturalGuides.astro';
const { gallery, title } = Astro.props;
---
<div class="project-gallery">{gallery.map((item: { title: string; image: string; page: number }, index: number) => <section class="gallery-section" data-depth-board={/axo|maquette|model/i.test(item.title) ? "true" : undefined}><div class="gallery-heading"><span class="eyebrow">{String(index+1).padStart(2,'0')} / {t('PROCESSUS')}</span><h2>{item.title}</h2><span class="eyebrow">PORTFOLIO · P. {item.page}</span></div><figure><ArchitecturalGuides/><button class="gallery-zoom" data-gallery-open aria-label={`${t('Agrandir')} : ${item.title}`}><Visual file={item.image} alt={`${title} - ${item.title}, ${t('planche du portfolio')}`} sizes="(max-width: 700px) 100vw, 90vw"/><span class="zoom-label">{t("AGRANDIR ↗")}</span></button><figcaption>{title} · {item.title}</figcaption></figure></section>)}</div>
<dialog class="lightbox" aria-label={t("Vue agrandie du portfolio")}><div class="lightbox-toolbar"><p class="lightbox-caption"></p><button class="lightbox-close" aria-label={t("Fermer la vue agrandie")}>{t("Fermer ×")}</button></div><img class="lightbox-image" alt=""/></dialog>
<script>
function setupGallery() { const dialog = document.querySelector<HTMLDialogElement>('.lightbox'); if (!dialog) return; const image = dialog.querySelector<HTMLImageElement>('.lightbox-image')!; let opener: HTMLElement | null = null; document.querySelectorAll<HTMLButtonElement>('[data-gallery-open]').forEach(button => button.addEventListener('click', () => { const original = button.querySelector('img')!; opener = button; image.src = original.srcset?.split(',').at(-1)?.trim().split(/\s+/)[0] || original.currentSrc || original.src; image.alt = original.alt; dialog.querySelector('.lightbox-caption')!.textContent = original.alt; dialog.showModal(); document.body.classList.add('modal-open'); })); dialog.querySelector('.lightbox-close')!.addEventListener('click', () => dialog.close()); dialog.addEventListener('click', e => { if (e.target === dialog) dialog.close(); }); dialog.addEventListener('close', () => { document.body.classList.remove('modal-open'); opener?.focus(); }); }
document.addEventListener('astro:page-load',setupGallery);
</script>
