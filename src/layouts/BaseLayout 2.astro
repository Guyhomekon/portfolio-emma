---
import { ClientRouter } from 'astro:transitions';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '../styles/global.css';
const { title, description, project } = Astro.props;
---
<!doctype html><html lang="fr"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#faf9f6"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><SEO title={title} description={description} project={project}/><ClientRouter/></head><body id="top"><a href="#main" class="skip-link">Aller au contenu</a><Header/><main id="main"><slot/></main><Footer/></body></html>
