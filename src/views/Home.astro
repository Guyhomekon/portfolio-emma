---
import { translator, pathFor } from '../i18n';
const t = translator(Astro.url);
const path = pathFor(Astro.url);
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Visual from '../components/Visual.astro';
import ArchitecturalGuides from '../components/ArchitecturalGuides.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import ContactCTA from '../components/ContactCTA.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import { introduction } from '../data/profile';
const projects = (await getCollection('projects')).sort((a,b) => a.data.number.localeCompare(b.data.number));
---
<BaseLayout><section class="hero shell" aria-labelledby="hero-title"><div class="hero-topline eyebrow"><span>{t("PORTFOLIO - 2026")}</span><span>{t("UNE APPROCHE SENSIBLE DE L’ESPACE")}</span></div><div class="hero-composition"><ArchitecturalGuides cover/><div class="hero-text"><span class="eyebrow hero-index">{t("DESIGN D’ESPACE")}<br/>{t("ARCHITECTURE INTÉRIEURE")}<br/>{t("SCÉNOGRAPHIE")}</span><h1 id="hero-title"><span class="cover-line"><span>{t("Habiter")}</span></span><br/><span class="cover-line"><span>{t("l’espace.")}</span></span><br/><span class="cover-line"><em>{t("Éveiller")}</em></span><br/><span class="cover-line"><em>{t("les sens.")}</em></span></h1><div class="hero-signature"><span>{t("Emma Expert")}</span><span class="eyebrow">{t("NICE / PARIS, FRANCE")}</span></div></div><a href={path("/projets/habitat-de-a-a-z/")} class="hero-visual"><Visual file="p6-0.png" alt={t("Habitat de A à Z : intérieur lumineux, bois chaleureux et pouf vert minéral")} eager sizes="(max-width: 700px) 90vw, 50vw"/><span class="hero-vertical">{t("HABITAT DE A À Z - ARCHITECTURE INTÉRIEURE")}</span><span class="hero-image-caption"><span>{t("01 - HABITAT DE A À Z")}</span><span>{t("VOIR LE PROJET ↗")}</span></span></a></div><div class="hero-bottom"><a href="#selection">{t("EXPLORER LE PORTFOLIO")} <span>↓</span></a><span class="eyebrow">{t("DE L’INTENTION À LA MATIÈRE.")}</span></div></section>
<section class="introduction shell"><span class="eyebrow">{t("LE REGARD")}</span><div><h2>{t("Donner à chaque espace")}<br/><em>{t("une fonction juste.")}</em></h2><p>{t("J’ai grandi entre imagination et création. Concevoir des lieux qui améliorent l’expérience de chacun est ce qui me passionne.")}</p><a class="text-link" href={path("/a-propos/")}>{t("Découvrir mon parcours ↗")}</a></div><span class="intro-marker" aria-hidden="true">{t("e.")}</span></section>
<section id="selection" class="selected shell"><SectionHeading number="01" title={t("Espaces à vivre")} note={t("PROJETS ACADÉMIQUES · 3 PROJETS")}/><div class="selected-projects">{projects.filter(p=>p.data.featured).map(p=><ProjectPreview project={p}/>)}</div><a class="text-link all-projects" href={path("/projets/")}>{t("Le portfolio complet")} <span>↗</span></a></section>
<section class="scenography shell"><SectionHeading number="02" title={t("Habiter autrement")} note={t("SCÉNOGRAPHIE")}/><div class="section-intro"><p>{t("Entre réalité et imaginaire,")}<br/>{t("l’espace devient un récit.")}</p><span class="eyebrow">{t("EXPLORATIONS SPATIALES")}<br/>{t("ET SENSIBLES")}</span></div><div class="two-projects">{projects.filter(p=>['habiter-la-scene','les-arches-vielha'].includes(p.id)).map(p=><ProjectPreview project={p} compact/>)}</div></section>
<section class="drawings shell"><SectionHeading number="03" title={t("Le langage du trait")} note={t("DESSINS & RECHERCHES")}/><div class="drawing-composition"><a href={path("/projets/dessins/")} class="drawing-first"><Visual file="p31-0.png" alt={t("Dessin d’une basilique au crayon")}/><span class="eyebrow">{t("ARCHITECTURE · CRAYON")}</span></a><div class="drawing-text"><h3>{t("Observer,")}<br/><em>{t("avant de concevoir.")}</em></h3><p>{t("Architecture, objets, corps : le dessin permet de comprendre les volumes et de donner forme aux idées.")}</p><a href={path("/projets/dessins/")} class="text-link">{t("Ouvrir le carnet ↗")}</a></div><a href={path("/projets/dessins/")} class="drawing-last"><Visual file="p33-1.png" alt={t("Étude de la chaise Wassily de Marcel Breuer au feutre noir")}/><span class="eyebrow">{t("OBJETS · FEUTRE FIN")}</span></a></div></section>
<section class="about-preview shell"><div class="portrait"><Visual file="p3-20.png" alt={t("Portrait en noir et blanc d’Emma Expert")}/><span class="eyebrow">{t("EMMA EXPERT · DESIGNER D’ESPACE")}</span></div><div class="about-preview-text"><span class="eyebrow">{t("À PROPOS")}</span><h2>{t("Entre imagination")}<br/><em>{t("et création.")}</em></h2><p>{t(introduction)}</p><a href={path("/a-propos/")} class="text-link">{t("À propos d’Emma ↗")}</a></div></section>
<section class="experience shell"><SectionHeading number="04" title={t("Au contact du réel")} note={t("EXPÉRIENCES")}/><ExperienceTimeline/><div class="experience-links"><a href={path("/projets/#en-stage")} class="text-link">{t("Les travaux en stage ↗")}</a><a href={path("/a-propos/#parcours")} class="text-link">{t("Tout le parcours ↗")}</a></div></section><ContactCTA/></BaseLayout>
