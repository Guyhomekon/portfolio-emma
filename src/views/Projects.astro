---
import { translator } from '../i18n';
const t = translator(Astro.url);
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ContactCTA from '../components/ContactCTA.astro';
const projects = (await getCollection('projects')).sort((a,b) => a.data.number.localeCompare(b.data.number));
const categories = [{ title:'Projets académiques', number:'01', id:'academiques' },{ title:'Travaux complémentaires', number:'02', id:'complementaires' },{ title:'En stage', number:'03', id:'en-stage' }];
---
<BaseLayout title={t("Projets - Emma Expert")}><div class="page-heading shell"><span class="eyebrow">{t("PORTFOLIO · SOMMAIRE")}</span><h1>{t("Une intention.")}<br/><em>{t("Des espaces.")}</em></h1><p>{t("Architecture intérieure, scénographie et recherche plastique.")}<br/>{t("Trois chapitres pour découvrir mon travail.")}</p><nav class="chapter-nav" aria-label={t("Chapitres du portfolio")}>{categories.map(c=><a href={`#${c.id}`}><span>{c.number}</span>{t(c.title)} ↓</a>)}</nav></div>{categories.map(c=><section class="project-category shell" id={c.id}><SectionHeading title={t(c.title)} number={c.number}/><div class:list={['catalogue', {'academic-catalogue':c.id==='academiques'}]}>{projects.filter(p=>p.data.category===c.title).map(p=><ProjectPreview project={p} compact={c.id!=='academiques'}/>)}</div></section>)}<ContactCTA/></BaseLayout>
